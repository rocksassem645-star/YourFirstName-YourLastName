<header class="custom-navbar">
  <div class="custom-navbar__inner">

    <a href="{{ routes.root_url }}" class="custom-navbar__logo">
      {{ shop.name }}
    </a>

    <nav class="custom-navbar__links" aria-label="Main navigation">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="/pages/about">About</a>
      <a href="/pages/contact">Contact</a>
    </nav>

    <div class="custom-navbar__actions">
      <a href="{{ routes.search_url }}" aria-label="Search">
        Search
      </a>

      <a href="{{ routes.cart_url }}" aria-label="Cart">
        Cart
      </a>
    </div>

  </div>
</header>

<style>
  .custom-navbar {
    width: 100%;
    background: #fff;
    border-bottom: 1px solid #eee;
    position: relative;
    z-index: 20;
  }

  .custom-navbar__inner {
    max-width: 1200px;
    min-height: 64px;
    margin: 0 auto;
    padding: 0 24px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .custom-navbar a {
    color: #111;
    text-decoration: none;
  }

  .custom-navbar__logo {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .custom-navbar__links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex: 1;
  }

  .custom-navbar__links a,
  .custom-navbar__actions a {
    font-size: 13px;
    font-weight: 500;
  }

  .custom-navbar__links a:hover,
  .custom-navbar__actions a:hover {
    opacity: 0.55;
  }

  .custom-navbar__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .custom-navbar__inner {
      min-height: 58px;
      padding: 0 16px;
      gap: 16px;
    }

    .custom-navbar__links {
      display: none;
    }

    .custom-navbar__logo {
      font-size: 17px;
    }

    .custom-navbar__actions {
      gap: 14px;
    }
  }
</style>