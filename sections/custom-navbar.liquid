<nav class="custom-navbar">
  <div class="navbar-container">

    <a href="{{ routes.root_url }}" class="navbar-logo">
      <span class="logo-text">{{ shop.name }}</span>
    </a>

    <button
      class="navbar-toggle"
      id="navbar-toggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="navbar-menu" id="navbar-menu">

      <li class="navbar-item">
        <a href="#shop" class="navbar-link">Shop</a>
      </li>

      <li class="navbar-item">
        <a href="#about" class="navbar-link">About</a>
      </li>

      <li class="navbar-item">
        <a href="#contact" class="navbar-link">Contact</a>
      </li>

      <li class="navbar-item navbar-cart">
        <a
          href="{{ routes.cart_url }}"
          class="navbar-link"
          title="Shopping Cart"
          aria-label="Shopping Cart"
        >
          🛒
        </a>
      </li>

    </ul>

  </div>
</nav>

<style>
  .custom-navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: #fff;
    color: #000;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    height: 70px;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar-logo {
    text-decoration: none;
    color: inherit;
  }

  .logo-text {
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .navbar-menu {
    display: flex;
    align-items: center;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .navbar-item {
    margin: 0;
    padding: 0;
  }

  .navbar-link {
    position: relative;
    color: inherit;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }

  .navbar-link:hover {
    opacity: 0.7;
  }

  .navbar-link::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background: currentColor;
    transition: width 0.3s ease;
  }

  .navbar-link:hover::after {
    width: 100%;
  }

  .navbar-cart .navbar-link::after {
    display: none;
  }

  .navbar-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .navbar-toggle span {
    width: 25px;
    height: 3px;
    background: currentColor;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .navbar-container {
      height: 60px;
      padding: 0 15px;
    }

    .navbar-toggle {
      display: flex;
    }

    .navbar-menu {
      position: absolute;
      top: 60px;
      left: 0;
      width: 100%;
      flex-direction: column;
      gap: 0;
      background: #fff;

      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .navbar-menu.active {
      max-height: 300px;
    }

    .navbar-item {
      width: 100%;
    }

    .navbar-link {
      display: block;
      padding: 15px 20px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
      font-size: 16px;
    }

    .navbar-link::after {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const toggle = document.getElementById('navbar-toggle');
    const menu = document.getElementById('navbar-menu');

    if (!toggle || !menu) return;

    toggle.addEventListener('click', function () {
      menu.classList.toggle('active');

      const expanded = menu.classList.contains('active');
      toggle.setAttribute('aria-expanded', expanded);
    });
  });
</script>