<section id="shop" class="custom-product-grid-section">
  <h2 class="section-heading">Tisso vision in the wild</h2>

  <div class="custom-grid-2x3">
    {% for product in collections.all.products limit: 6 %}
      <div class="custom-grid-item">

        <a href="{{ product.url }}">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.featured_image.alt | escape }}"
              class="grid-item-img"
              loading="lazy"
            >
          {% endif %}
        </a>

        <button
          class="quickview-trigger"
          type="button"
          data-product-id="{{ product.id }}"
          aria-label="Quick view {{ product.title | escape }}"
        >
          <span class="quickview-icon">👁</span>
        </button>

      </div>
    {% endfor %}
  </div>
</section>

<style>
  .custom-product-grid-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
    background: #fff;
  }

  .section-heading {
    font-size: 28px;
    font-weight: 600;
    margin: 0 0 40px;
    line-height: 1.2;
    color: #000;
  }

  .custom-grid-2x3 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .custom-grid-item {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #fafafa;
    overflow: hidden;
    border-radius: 4px;
  }

  .custom-grid-item > a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .grid-item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease;
  }

  .custom-grid-item:hover .grid-item-img {
    opacity: 0.85;
  }

  .quickview-trigger {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);

    width: 56px;
    height: 56px;

    background: rgba(0, 0, 0, 0.7);
    border: 2px solid #fff;
    border-radius: 50%;

    cursor: pointer;
    z-index: 2;

    display: flex;
    align-items: center;
    justify-content: center;

    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .custom-grid-item:hover .quickview-trigger {
    opacity: 1;
  }

  .quickview-trigger:hover {
    background: rgba(0, 0, 0, 0.9);
  }

  .quickview-icon {
    font-size: 24px;
    color: #fff;
  }

  @media (min-width: 769px) {
    .custom-grid-2x3 {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }

    .custom-product-grid-section {
      padding: 80px 20px;
    }

    .section-heading {
      font-size: 32px;
      margin-bottom: 50px;
    }
  }

  @media (max-width: 480px) {
    .custom-product-grid-section {
      padding: 40px 15px;
    }

    .section-heading {
      font-size: 20px;
      margin-bottom: 25px;
    }

    .custom-grid-2x3 {
      gap: 15px;
    }

    .quickview-trigger {
      width: 48px;
      height: 48px;
    }

    .quickview-icon {
      font-size: 20px;
    }
  }
</style>