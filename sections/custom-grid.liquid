{% comment %}
  Custom Product Grid Section
  - Shows 6 products
  - Products selectable from Shopify Customizer
  - Each product opens popup with details
{% endcomment %}

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "The Gift Guide"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="custom-grid">
  <h2 class="grid-title">{{ section.settings.section_title }}</h2>
  
  <div class="product-grid">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      
      {% if product != blank %}
        <div class="product-card" data-product-id="{{ product.id }}">
          <div class="product-image">
            <img 
              src="{{ product.featured_image | img_url: '400x400' }}" 
              alt="{{ product.title }}"
              loading="lazy"
            >
          </div>
          <div class="product-info">
            <h3 class="product-title">{{ product.title }}</h3>
            <p class="product-price">{{ product.price | money }}</p>
            <button 
              class="view-product-btn" 
              data-product-id="{{ product.id }}"
              aria-label="Quick view {{ product.title }}"
            >
              Quick View
            </button>
          </div>
        </div>
      {% endif %}
      
    {% endfor %}
  </div>
</div>

<style>
.custom-grid {
  padding: 80px 20px;
  max-width: 1200px;
  margin: 0 auto;
}

.grid-title {
  text-align: center;
  font-size: 38px;
  font-weight: 700;
  margin-bottom: 50px;
  letter-spacing: 1px;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.product-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  transition: all 0.4s ease;
  text-align: center;
  padding: 20px 20px 25px;
  border: 1px solid #f0f0f0;
}

.product-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  border-color: #ddd;
}

.product-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 8px;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-card:hover .product-image img {
  transform: scale(1.05);
}

.product-title {
  font-size: 16px;
  margin: 15px 0 5px;
  font-weight: 500;
}

.product-price {
  font-weight: 700;
  font-size: 18px;
  color: #1a1a1a;
  margin-bottom: 15px;
}

.view-product-btn {
  padding: 10px 30px;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 50px;
  cursor: pointer;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.3s ease;
  letter-spacing: 0.5px;
}

.view-product-btn:hover {
  background: #333;
  transform: scale(1.05);
}

/* Mobile Responsive */
@media (max-width: 992px) {
  .product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}

@media (max-width: 576px) {
  .custom-grid {
    padding: 50px 15px;
  }
  .grid-title {
    font-size: 28px;
    margin-bottom: 30px;
  }
  .product-grid {
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }
  .product-card {
    padding: 12px;
  }
  .product-title {
    font-size: 14px;
  }
  .product-price {
    font-size: 15px;
  }
  .view-product-btn {
    padding: 8px 20px;
    font-size: 12px;
  }
}
</style>