{% comment %}
  Custom Banner Section
  - All text editable from Shopify Customizer
  - Button with hover animation
{% endcomment %}

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our curated collection and find the perfect gifts to delight your loved ones this holiday season"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="custom-banner" style="background-image: url('{{ section.settings.background_image | img_url: '1920x' }}');">
  <div class="banner-overlay"></div>
  <div class="banner-content">
    <h1 class="banner-heading">{{ section.settings.heading }}</h1>
    <p class="banner-subheading">{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.button_link }}" class="banner-button">
      {{ section.settings.button_text }}
    </a>
  </div>
</div>

<style>
.custom-banner {
  position: relative;
  padding: 120px 20px;
  text-align: center;
  background-size: cover;
  background-position: center;
  min-height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
}

.banner-content {
  position: relative;
  z-index: 1;
  max-width: 800px;
  margin: 0 auto;
}

.banner-heading {
  font-size: 52px;
  font-weight: 700;
  margin-bottom: 20px;
  animation: fadeInUp 1s ease;
}

.banner-subheading {
  font-size: 20px;
  margin-bottom: 30px;
  line-height: 1.6;
  animation: fadeInUp 1.2s ease;
}

.banner-button {
  display: inline-block;
  padding: 16px 50px;
  background: #000;
  color: #fff;
  text-decoration: none;
  border-radius: 50px;
  font-weight: 600;
  font-size: 16px;
  letter-spacing: 1px;
  transition: all 0.4s ease;
  animation: fadeInUp 1.4s ease;
  border: 2px solid transparent;
}

.banner-button:hover {
  transform: translateY(-5px) scale(1.05);
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
  background: #1a1a1a;
  border-color: #fff;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .custom-banner {
    padding: 80px 20px;
    min-height: 350px;
  }
  .banner-heading {
    font-size: 32px;
  }
  .banner-subheading {
    font-size: 16px;
  }
  .banner-button {
    padding: 14px 35px;
    font-size: 14px;
  }
}
</style>