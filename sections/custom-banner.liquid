{% schema %}
{
  "name": "Custom Gift Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover joy. Your ultimate holiday gift destination. Explore our curated collection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Choose Gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Line Art Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Gift Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<!-- ============================================================
     CUSTOM GIFT BANNER SECTION
     Fully editable from customizer
     Responsive layout with hero image/illustration
     ============================================================ -->
<section 
  class="custom-gift-banner"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="banner-inner">
    <!-- TEXT CONTENT -->
    <div class="banner-text">
      <h1 style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h1>
      <p style="color: {{ section.settings.subtext_color }};">
        {{ section.settings.subtext }}
      </p>
      <a 
        href="{{ section.settings.button_link | default: '#' }}" 
        class="btn-black"
      >
        {{ section.settings.button_text }}
      </a>
    </div>

    <!-- IMAGE / ILLUSTRATION -->
    <div class="banner-art">
      {% if section.settings.side_image != blank %}
        <img
          src="{{ section.settings.side_image | image_url: width: 800 }}"
          loading="lazy"
          alt="{{ section.settings.heading }}"
          class="banner-image"
        >
      {% else %}
        <!-- Fallback placeholder -->
        <div class="placeholder-art">Line Art Here</div>
      {% endif %}
    </div>
  </div>
</section>

<!-- ============================================================
     STYLES
     Mobile-first responsive design
     ============================================================ -->
<style>
  /* ============================================================
     BANNER CONTAINER
     ============================================================ */

  .custom-gift-banner {
    padding: 60px 20px;
    max-width: 1200px;
    margin: 0 auto;
    transition: background-color 0.3s ease;
  }

  .banner-inner {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 40px;
  }

  /* ============================================================
     TEXT CONTENT
     ============================================================ */

  .banner-text {
    flex: 1;
    max-width: 550px;
    text-align: center;
  }

  .banner-text h1 {
    font-size: 52px;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 20px;
    line-height: 1.1;
  }

  .banner-text p {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 30px;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ============================================================
     BUTTON
     ============================================================ */

  .btn-black {
    display: inline-block;
    background: #000;
    color: #fff;
    padding: 14px 32px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.3s ease;
    border-radius: 4px;
  }

  .btn-black:hover {
    background: #333;
  }

  /* ============================================================
     IMAGE / ILLUSTRATION CONTAINER
     ============================================================ */

  .banner-art {
    flex: 1;
    width: 100%;
    max-width: 600px;
  }

  .banner-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }

  /* Placeholder for when no image is uploaded */
  .placeholder-art {
    width: 100%;
    padding-top: 80%;
    background: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    border: 2px dashed #ccc;
    font-size: 14px;
    border-radius: 8px;
  }

  /* ============================================================
     TABLET & DESKTOP LAYOUT
     Side-by-side text and image
     ============================================================ */

  @media (min-width: 769px) {
    .custom-gift-banner {
      padding: 100px 20px;
    }

    .banner-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 60px;
    }

    .banner-text {
      text-align: left;
      flex: 0 1 45%;
    }

    .banner-text p {
      margin-left: 0;
    }

    .banner-art {
      flex: 0 1 50%;
    }

    .banner-text h1 {
      font-size: 48px;
    }
  }

  /* ============================================================
     MOBILE OPTIMIZATION
     ============================================================ */

  @media (max-width: 768px) {
    .banner-text h1 {
      font-size: 34px;
    }

    .banner-text p {
      font-size: 14px;
    }

    .btn-black {
      padding: 12px 28px;
      font-size: 12px;
    }
  }

  @media (max-width: 480px) {
    .custom-gift-banner {
      padding: 40px 15px;
    }

    .banner-inner {
      gap: 30px;
    }

    .banner-text h1 {
      font-size: 28px;
      margin-bottom: 15px;
    }

    .banner-text p {
      font-size: 13px;
      margin-bottom: 20px;
    }

    .placeholder-art {
      padding-top: 70%;
      font-size: 12px;
    }
  }
</style>