{% schema %}
{
  "name": "Custom Gift Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover joy. Your ultimate holiday gift destination. Explore our curated collection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Choose Gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Line Art Image"
    }
  ],
  "presets": [
    {
      "name": "Custom Gift Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="custom-gift-banner">
  <div class="banner-inner">
    <div class="banner-text">
      <div class="editable-box heading-box">
  <h1>{{ section.settings.heading }}</h1>
        </div>
      <p>{{ section.settings.subtext }}</p>
      <a href="{{ section.settings.button_link | default: '#' }}" class="btn-black">
        {{ section.settings.button_text }}
      </a>
    </div>
    <div class="banner-art">
      {% if section.settings.side_image != blank %}
        <img 
          src="{{ section.settings.side_image | image_url: width: 800 }}" 
          loading="lazy" 
          alt="{{ section.settings.heading }}"
        >
      {% else %}
        <!-- Fallback placeholder in case no image is picked -->
        <div class="placeholder-art">Line Art Here</div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .custom-gift-banner {
    padding: 60px 20px;
    max-width: 1200px;
    margin: 0 auto;
    background: #fff;
  }
  .banner-inner {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 40px;
  }
  .banner-text {
    flex: 1;
    max-width: 550px;
    text-align: center;
  }
  .banner-text h1 {
    font-size: 52px;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 20px;
    line-height: 1.1;
    color: #000;
  }
  .banner-text p {
    font-size: 16px;
    color: #333;
    line-height: 1.6;
    margin-bottom: 30px;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }
  .btn-black {
    display: inline-block;
    background: #000;
    color: #fff;
    padding: 14px 32px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.3s ease;
  }
  .btn-black:hover {
    background: #333;
  }
  .banner-art {
    flex: 1;
    width: 100%;
    max-width: 600px;
  }
  .banner-art img {
    width: 100%;
    height: auto;
    display: block;
  }
  .placeholder-art {
    width: 100%;
    padding-top: 60%;
    background: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    border: 2px dashed #ccc;
    font-size: 14px;
  }

  @media (min-width: 769px) {
    .banner-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      text-align: left;
    }
    .banner-text p {
      margin-left: 0;
    }
    .banner-text {
      text-align: left;
    }
  }
  @media (max-width: 768px) {
    .banner-text h1 {
      font-size: 34px;
    }
    .banner-text p {
      font-size: 14px;
    }
  }
</style>